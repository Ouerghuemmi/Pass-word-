# Environment Configuration for Autonomous AI Organization
# Copy this file to .env and update values for your environment

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DB_USER=aio_user
DB_PASSWORD=change_this_password_in_production
DB_NAME=autonomous_org
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
QDRANT_API_KEY=change_this_qdrant_key
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# API
SECRET_KEY=change_this_secret_key_in_production
SECRET_KEY_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_grafana_password

# LLM API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Temporal
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default

# Organization Settings
ORG_NAME=Autonomous AI Organization
ORG_TIMEZONE=UTC
ORG_LANGUAGE=en

# Feature Flags
ENABLE_MARKET_INTELLIGENCE=true
ENABLE_COMPETITOR_ANALYSIS=true
ENABLE_PRODUCT_DISCOVERY=true
ENABLE_EXECUTION_AUTOMATION=true
ENABLE_SELF_EVOLUTION=true

# Performance
MAX_AGENTS=50
MAX_CONCURRENT_TASKS=100
TASK_TIMEOUT_SECONDS=3600

# Monitoring
METRICS_PORT=9090
LOGS_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=365
